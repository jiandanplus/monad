{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "resolveJsonModule": true, "esModuleInterop": true, "allowJs": true,
    "checkJs": false, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
